msgid "Back"
msgstr "Air ais"

msgid "Close"
msgstr "Dùin"

msgid "Crashlog Viewer"
msgstr "Sealladair Crashlog"

msgid "Deleted %d files"
msgstr "Chaidh %d faidhle a sguabadh às"

msgid "Error Only"
msgstr "Mearachd a-mhàin"

msgid "Error opening file: %s"
msgstr "Mearachd a' fosgladh an fhaidhle: %s"

msgid "Error: %s"
msgstr "Mearachd: %s"

msgid "File already removed"
msgstr "Chaidh am faidhle a thoirt air falbh mu thràth"

msgid "Full Log"
msgstr "Log slàn"

msgid "No crash logs found"
msgstr "Cha deach logaichean tubaist a lorg"

msgid "No file selected"
msgstr "Cha deach faidhle a thaghadh"

msgid "No files deleted"
msgstr "Cha deach faidhlichean a sguabadh às"

msgid "No specific error trace found in log"
msgstr "Cha deach lorg mearachd sònraichte a lorg sa loga"

msgid "Press OK or RED to return"
msgstr "Brùth OK no RED airson tilleadh"

msgid "Remove"
msgstr "Thoir air falbh"

msgid "Remove All"
msgstr "Thoir air falbh a h-uile"

msgid "Removed: %s"
msgstr "Air a thoirt air falbh: %s"

msgid "View"
msgstr "Sealladh"

msgid "View Crashlog file: %s"
msgstr "Seall am faidhle Crashlog: %s"

msgid "View | Remove Crashlog files"
msgstr "Seall | Thoir air falbh faidhlichean Crashlog"
