msgid "Back"
msgstr "ପଛକୁ"

msgid "Close"
msgstr "ବନ୍ଦ"

msgid "Crashlog Viewer"
msgstr "କ୍ରାସ୍ଲଗ୍ ଦର୍ଶକ |"

msgid "Deleted %d files"
msgstr "% D ଫାଇଲ୍ ଡିଲିଟ୍ ହୋଇଛି |"

msgid "Error Only"
msgstr "କେବଳ ତ୍ରୁଟି |"

msgid "Error opening file: %s"
msgstr "ଫାଇଲ୍ ଖୋଲିବାରେ ତ୍ରୁଟି:% s"

msgid "Error: %s"
msgstr "ତ୍ରୁଟି:% s"

msgid "File already removed"
msgstr "ଫାଇଲ୍ ପୂର୍ବରୁ ଅପସାରିତ ହୋଇଛି |"

msgid "Full Log"
msgstr "ପୂର୍ଣ୍ଣ ଲଗ୍ |"

msgid "No crash logs found"
msgstr "କ crash ଣସି କ୍ରାସ୍ ଲଗ୍ ମିଳିଲା ନାହିଁ |"

msgid "No file selected"
msgstr "କ file ଣସି ଫାଇଲ ଚୟନ ହୋଇନାହିଁ |"

msgid "No files deleted"
msgstr "କ files ଣସି ଫାଇଲ ବିଲୋପ ହୋଇନାହିଁ |"

msgid "No specific error trace found in log"
msgstr "ଲଗରେ କ specific ଣସି ନିର୍ଦ୍ଦିଷ୍ଟ ତ୍ରୁଟି ଚିହ୍ନ ନାହିଁ |"

msgid "Press OK or RED to return"
msgstr "ଫେରିବା ପାଇଁ ଓକେ କିମ୍ବା RED ଦବାନ୍ତୁ |"

msgid "Remove"
msgstr "ଅପସାରଣ କରନ୍ତୁ |"

msgid "Remove All"
msgstr "ସମସ୍ତ ଅପସାରଣ କରନ୍ତୁ |"

msgid "Removed: %s"
msgstr "ଅପସାରିତ:% s"

msgid "View"
msgstr "ଦର୍ଶନ କରନ୍ତୁ |"

msgid "View Crashlog file: %s"
msgstr "କ୍ରାଶଲଗ୍ ଫାଇଲ୍ ଦେଖନ୍ତୁ:% s |"

msgid "View | Remove Crashlog files"
msgstr "ଦେଖନ୍ତୁ | କ୍ରାସଲଗ୍ ଫାଇଲଗୁଡିକ ଅପସାରଣ କରନ୍ତୁ |"
