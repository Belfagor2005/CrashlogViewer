msgid "Back"
msgstr "Ետ"

msgid "Close"
msgstr "Փակել"

msgid "Crashlog Viewer"
msgstr ""

msgid "Deleted %d files"
msgstr "Ջնջվել է %d ֆայլ"

msgid "Error Only"
msgstr "Միայն սխալ"

msgid "Error opening file: %s"
msgstr "Ֆայլի բացման սխալ՝ %s"

msgid "Error: %s"
msgstr "Սխալ՝ %s"

msgid "File already removed"
msgstr "Ֆայլն արդեն հեռացվել է"

msgid "Full Log"
msgstr "Ամբողջական մատյան"

msgid "No crash logs found"
msgstr "Խափանումների մատյաններ չեն գտնվել"

