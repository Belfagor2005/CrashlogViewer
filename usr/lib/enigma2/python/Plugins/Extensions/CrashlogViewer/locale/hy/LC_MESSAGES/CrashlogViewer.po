msgstr "Հեռացնել բոլորը"

msgid "Removed: %s"
msgstr "Հեռացվել է՝ %s"

msgid "View"
msgstr "Դիտել"

msgid "View Crashlog file: %s"
msgstr "Դիտեք Crashlog ֆայլը՝ %s"

msgid "View | Remove Crashlog files"
msgstr "Դիտել | Հեռացրեք Crashlog ֆայլերը"
