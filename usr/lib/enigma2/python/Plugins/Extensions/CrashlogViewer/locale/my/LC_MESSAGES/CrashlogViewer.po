msgid "Back"
msgstr "ကျော"

msgid "Close"
msgstr "ပိတ်လိုက်"

msgid "Crashlog Viewer"
msgstr "Crashlog ကြည့်ရှုသူ"

msgid "Deleted %d files"
msgstr "ဖိုင် %d ဖိုင်ကို ဖျက်လိုက်ပါပြီ။"

msgid "Error Only"
msgstr "အမှားသာ"

msgid "Error opening file: %s"
msgstr "ဖိုင်ဖွင့်ရာတွင် အမှားအယွင်းရှိသည်- %s"

msgid "Error: %s"
msgstr "အမှား- %s"

msgid "File already removed"
msgstr "ဖိုင်ကို ဖယ်ရှားပြီးပါပြီ။"

msgid "Full Log"
msgstr "မှတ်တမ်းအပြည့်အစုံ"

msgid "No crash logs found"
msgstr "ပျက်စီးမှုမှတ်တမ်းများ မတွေ့ပါ။"

msgid "No file selected"
msgstr "ဖိုင်ကို ရွေးထားခြင်းမရှိပါ။"

msgid "No files deleted"
msgstr "ဖိုင်များကို ဖျက်မထားပါ။"

msgid "No specific error trace found in log"
msgstr "မှတ်တမ်းတွင် သီးခြားအမှားအယွင်း သဲလွန်စမတွေ့ပါ။"

msgid "Press OK or RED to return"
msgstr "ပြန်လာရန် OK သို့မဟုတ် RED ကိုနှိပ်ပါ။"

msgid "Remove"
msgstr "ဖယ်ရှားပါ။"

msgid "Remove All"
msgstr "အားလုံးကို ဖယ်ရှားပါ။"

msgid "Removed: %s"
msgstr "ဖယ်ရှားထားသည်- %s"

msgid "View"
msgstr "အမြင်"

msgid "View Crashlog file: %s"
msgstr "Crashlog ဖိုင်ကိုကြည့်ပါ- %s"

msgid "View | Remove Crashlog files"
msgstr "အမြင် | Crashlog ဖိုင်များကို ဖယ်ရှားပါ။"

